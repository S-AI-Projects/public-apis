    "entries": [
      {
        "name": "Advice Slip",
        "url": "http://api.adviceslip.com/",
        "line": 10
      },
      {
        "name": "Advice Slip Mirror",
        "url": "http://api.adviceslip.com/",
        "line": 15
      }
    ],
    "expected_duplicate": true,
    "expected_match_type": "exact",
    "expected_reason_contains": "Exact match"
  },
