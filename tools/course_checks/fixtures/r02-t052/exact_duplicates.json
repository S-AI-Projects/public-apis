  "entries": [
    {
      "name": "AbuseIPDB",
      "url": "https://docs.abuseipdb.com/",
      "auth": "`apiKey`",
      "https": "Yes",
      "cors": "Unknown",
      "line": 244
    },
    {
      "name": "AbuseIPDB Mirror",
      "url": "https://docs.abuseipdb.com/",
      "auth": "`apiKey`",
      "https": "Yes",
      "cors": "Unknown",
      "line": 999
    }
  ],
  "expected": {
    "duplicate_groups": [
      {
        "match_type": "exact",
        "normalized_url": "https://docs.abuseipdb.com",
